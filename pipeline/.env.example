# Loxleys pipeline — copy to `.env` and fill in. `.env` is gitignored.

# Replicate API token for Flux Dev image generation.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: override the Flux model (defaults to config.FLUX_MODEL)
# FLUX_MODEL=black-forest-labs/flux-dev
