{
  "name": "loxleys-agent-api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "preflight": "node --import tsx src/preflight.ts",
    "preflight:production": "node --import tsx src/preflight.ts --production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "dotenv": "^16.6.1",
    "hono": "^4.9.8",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
